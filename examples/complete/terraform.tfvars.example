# Example Terraform Variables for Complete DNS Infrastructure

# AWS Configuration
aws_region = "us-east-1"

# Environment and Ownership
environment  = "prod"
owner        = "infrastructure-team"
cost_center  = "engineering"

# Domain Configuration
domain_name         = "example.com"
private_domain_name = "internal.example.com"

# VPC Configuration
vpc_id = "vpc-12345678"

# Website IP Addresses for Failover
primary_website_ip   = "203.0.113.1"
secondary_website_ip = "203.0.113.2"

# API Endpoint IP Addresses for Weighted Routing
api_us_east_ip = "203.0.113.10"
api_us_west_ip = "198.51.100.10"

# Hybrid DNS Configuration
enable_hybrid_dns = true
on_premises_domain = "corp.example.com"

# On-premises DNS servers for forwarding
on_premises_dns_servers = [
  {
    ip   = "192.168.1.10"
    port = 53
  },
  {
    ip   = "192.168.1.11"
    port = 53
  }
]
